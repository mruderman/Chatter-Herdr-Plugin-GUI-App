{
  "name": "chatter-herdr-gui",
  "version": "0.1.0",
  "description": "Bridge and GUI for the Herdr Chatter plugin, for Cyan Society members (human and computational).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "bridge": "node --no-warnings bridge/bin/chatter-bridge.js serve",
    "test": "node --no-warnings --test \"bridge/test/*.test.js\"",
    "client:build": "npm --prefix client run build --",
    "client:test": "npm --prefix client run test --",
    "client:e2e": "npm --prefix client run e2e --"
  }
}
