# Optional settings for the chatter-bridge systemd unit.
#   mkdir -p ~/.config/chatter-bridge
#   cp deploy/chatter-bridge.env.example ~/.config/chatter-bridge/env && chmod 600 ~/.config/chatter-bridge/env
# The unit reads this file through EnvironmentFile=-%h/.config/chatter-bridge/env, and restarts are needed to pick up
# an edit: systemctl --user restart chatter-bridge
#
# Format (systemd's, not a shell's): one KEY=value per line, no `export`, no $VAR, ~ or %h expansion (write absolute
# paths), # starts a comment. A value that contains double quotes goes in single quotes, as CHATTER_CMD below.
# A variable set here wins over the same one in the unit's Environment= lines.
# This file holds no secret and must never hold a token (member tokens are shown once, by the CLI, to their owner).
#
# Marks: [production] = set it on baremetalcyansociety (account letta); [unit] = the unit already sets it, so
# leave it commented unless you mean to override; [optional] = leave commented unless you need it.
# Every line below is commented out, so a file copied as it is changes nothing.

# [production] Where Chatter keeps its state. The bridge passes it to the `chatter` command as HERDR_PLUGIN_STATE_DIR.
# Unset, Chatter uses ~/.local/state/herdr/plugins/chatter only while that directory exists, so name it.
#CHATTER_STATE_DIR=/home/letta/.local/state/herdr/plugins/chatter

# [unit] How to run Chatter: a command name found on PATH, or a JSON array of argv words. On production `chatter` is
# on letta's PATH (~/.local/bin, which the unit's PATH line includes). The JSON form is for a Chatter that is not
# on PATH, for example a node and a script; single quotes keep the double quotes. Name the node by its absolute path
# and make it 22.13 or later: a bare "node" is looked up on the unit's PATH, which may find an older one (on a host whose
# /usr/bin/node is 18, Chatter then fails with "No such built-in module: node:sqlite" and /healthz answers 502).
#CHATTER_CMD=chatter
#CHATTER_CMD='["/usr/bin/node","--no-warnings","/home/someone/src/chatter/dist/bin/chatter.js"]'

# [unit] 1 trusts Tailscale identity headers (each one checked with `tailscale whois`), which is how humans sign in
# through `tailscale serve`. The bridge only believes them from loopback. Without it only bearer tokens work.
#CHATTER_BRIDGE_TRUST_TAILSCALE=1

# [unit] The built web client; must hold index.html or `serve` refuses to start. Read once, at start.
#CHATTER_BRIDGE_STATIC_DIR=/home/letta/chatter-bridge/releases/current/dist

# [optional] Bridge data: members, token hashes, the audit log, read pointers, per-member Chatter config.
# Default ~/.local/state/chatter-bridge. This is what to back up. The `chatter-bridge init|member|token|audit`
# commands read the same variable, so run them with the same value or they edit a different registry.
#CHATTER_BRIDGE_STATE_DIR=/home/letta/.local/state/chatter-bridge

# [optional] Chatter's config directory for the human admin (its `name` file is the admin's Chatter name).
# Default: Chatter's own, ~/.config/herdr/plugins/config/chatter. `chatter-bridge init` reads it only when
# --handle is not given, so on production run `init --handle <name>` and leave this unset.
#CHATTER_ADMIN_CONFIG_DIR=/home/letta/.config/herdr/plugins/config/chatter

# [optional] Origins allowed to call the API from another origin, comma separated. Default none. The web client is
# served by the bridge itself and is same-origin, so it does not need this.
#CHATTER_BRIDGE_ORIGINS=

# [optional] Where `serve` listens. The unit's ExecStart passes --host and --port, which win over these two, so
# they do nothing under the unit; change the ExecStart (and the `tailscale serve` target) instead. Loopback only.
#CHATTER_BRIDGE_HOST=127.0.0.1
#CHATTER_BRIDGE_PORT=8791

# The two below are not read by the bridge. It hands its environment on to every `chatter` command it runs, and
# Chatter reads them. Production needs neither: `herdr` is on PATH and its socket is in the default place.
# [optional] The herdr binary Chatter runs (Chatter's default: `herdr` on PATH).
#HERDR_BIN_PATH=/usr/bin/herdr
# [optional] A Herdr socket other than the default one, for a throwaway Herdr (docs/runbooks/herdr-test-env.md).
# Herdr sets this itself in its panes; that the CLI honors it from outside is not verified here.
#HERDR_SOCKET_PATH=
